    "playground.empty.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a downloaded model to try it here. Model selection arrives with the Models tab integration."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 모델을 선택해 여기에서 사용해 보세요. 모델 선택은 모델 탭 연동과 함께 제공됩니다."
          }
        }
      }
    },
