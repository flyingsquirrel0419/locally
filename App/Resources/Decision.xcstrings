      }
    },
    "decision.schema.invalidUTF8": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The schema text is not valid UTF-8."}},
        "ko": {"stringUnit": {"state": "translated", "value": "스키마 텍스트가 올바른 UTF-8이 아닙니다."}}
      }
    },
    "decision.schema.emptyKey": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Every question needs a non-empty key."}},
