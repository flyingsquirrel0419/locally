      }
    },
    "compatibility.risky.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The model is a tight fit for this device. It may run slowly, be terminated under memory pressure, or heat the device." } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 모델은 이 기기에 빠듯하게 맞습니다. 느리게 실행되거나 메모리 부족으로 종료되거나 기기가 뜨거워질 수 있습니다." } }
      }
    },
    "compatibility.risky.downloadAnyway": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Download Anyway" } },
        "ko": { "stringUnit": { "state": "translated", "value": "그래도 다운로드" } }
